# ============================================================================
# Telegram
# ============================================================================
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token

# ============================================================================
# Pinecone (векторная база)
# ============================================================================
PINECONE_API_KEY=pcsk_your-pinecone-key
PINECONE_INDEX_NAME=rag-bot-index
# Необязательно: параметры serverless-индекса (создаётся автоматически)
# PINECONE_REGION=us-east-1
# PINECONE_CLOUD=aws

# ============================================================================
# OpenAI-совместимый LLM-провайдер (например, ProxyAPI).
# ProxyAPI требует имён моделей С ПРЕФИКСОМ провайдера (openai/...).
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# ============================================================================
# Пайплайны и RAG (необязательно; значения по умолчанию — в app/config.py)
# ============================================================================
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_SEARCH_RESULTS=4
# MAX_HISTORY=20
# MAX_CONTEXT_DOCUMENTS=5
# MAX_AGENT_STEPS=8

# ============================================================================
# Обработка файлов через Docling (необязательно)
# ============================================================================
# Максимальный размер принимаемого файла, МБ (учитывайте лимит Telegram getFile ~20 МБ)
# MAX_FILE_SIZE_MB=20
# Сколько предложений в резюме по файлу (по задаче — ровно одно)
# SUMMARY_MAX_SENTENCES=1
# Режим экспорта Docling: doc_chunks | markdown
# DOCLING_EXPORT_TYPE=doc_chunks

# ============================================================================
# Namespaces в Pinecone (необязательно)
# ============================================================================
# NAMESPACE_KNOWLEDGE=knowledge
# NAMESPACE_USER_MEMORIES=user_memories
# NAMESPACE_DIALOG_CONTEXT=dialog_context

# ============================================================================
# Умная память: фильтрация дубликатов по косинусному сходству (необязательно)
# similarity < COSINE_SIMILARITY_THRESHOLD  -> новая запись (created)
# similarity >= COSINE_SIMILARITY_THRESHOLD -> дубликат (DUPLICATE_ACTION)
# ============================================================================
# COSINE_SIMILARITY_THRESHOLD=0.75
# DUPLICATE_ACTION=update
# DEDUPE_ENABLED=true
